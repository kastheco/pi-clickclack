CLICKCLACK_URL=http://127.0.0.1:8080
CLICKCLACK_WORKSPACE_ID=wsp_replace_me
CLICKCLACK_BOT_TOKEN=ccb_replace_me
CLICKCLACK_OWNER_IDS=usr_replace_me

# JSON arrays must stay on one line.
# A --persona service requires exactly one project in this array.
CLICKCLACK_PI_PROJECTS=[{"alias":"example","cwd":"/absolute/path/to/project"}]
CLICKCLACK_PI_INVOCATIONS=[{"conversationType":"channel","conversationId":"chn_replace_me","mode":"mention"},{"conversationType":"direct","conversationId":"dcn_replace_me","mode":"auto"}]

CLICKCLACK_PI_MODEL=provider/model-id
CLICKCLACK_PI_THINKING_LEVEL=medium
# Optional dedicated channel for durable commit/push/merge activity cards.
CLICKCLACK_GIT_ACTIVITY_CHANNEL_ID=chn_replace_me
# Required for --persona installs. Give every persona a different state file.
CLICKCLACK_PI_STATE_PATH=/absolute/path/to/pi-clickclack.sqlite
CLICKCLACK_PI_AGENT_DIR=/absolute/path/to/.pi/agent
