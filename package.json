{
  "name": "pi-clickclack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pi-clickclack-persona": "./scripts/add-persona.mjs"
  },
  "scripts": {
    "build": "bun run tsc -p tsconfig.json",
    "persona:add": "bun scripts/add-persona.mjs",
    "start": "bun --env-file-if-exists=.env src/index.ts",
    "service:install": "node scripts/install-user-service.mjs",
    "typecheck": "bun run tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:smoke": "bun test scripts/smoke/*.test.mjs",
    "test:injector-integration": "bun scripts/smoke/integration.mjs",
    "test:live-smoke": "bun scripts/smoke/live.mjs",
    "test:workflow-integration": "bun scripts/test-orkastrator-decision-integration.mjs",
    "test:workflow-durable-integration": "bun scripts/test-workflow-durable-integration.mjs"
  },
  "dependencies": {
    "@clickclack/sdk-ts": "file:../clickclack/packages/sdk-ts",
    "@oh-my-pi/pi-coding-agent": "18.3.5",
    "@osolmaz/pi-workflows": "file:vendor/osolmaz-pi-workflows-0.16.5-kas.769.9-omp.tgz",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
