{
  "name": "pi-clickclack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/*.test.js dist/**/*.test.js scripts/smoke/*.test.mjs",
    "test:smoke": "node --test scripts/smoke/*.test.mjs",
    "test:injector-integration": "node --experimental-vm-modules scripts/smoke/integration.mjs",
    "test:live-smoke": "node scripts/smoke/live.mjs",
    "test:workflow-integration": "node scripts/test-orkastrator-decision-integration.mjs",
    "test:workflow-durable-integration": "node scripts/test-workflow-durable-integration.mjs"
  },
  "dependencies": {
    "@clickclack/sdk-ts": "file:../clickclack/packages/sdk-ts",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@osolmaz/pi-workflows": "file:vendor/osolmaz-pi-workflows-0.16.0-kas.769.2.tgz",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
