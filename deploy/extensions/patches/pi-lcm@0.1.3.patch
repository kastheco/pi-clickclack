+import { Database as BunDatabase } from "bun:sqlite";
+
+// omp runs extensions on Bun, which can't load better-sqlite3. bun:sqlite covers
+// the rest of the API pi-lcm uses, so only the pragma helper is added here.
+class Database extends BunDatabase {
+  pragma(source: string): unknown[] {
+    return this.query(`PRAGMA ${source}`).all();
+  }
+}
+declare namespace Database {
+  type Database = InstanceType<typeof Database>;
