# the ClickClack bot runs with the same host-user filesystem, network, and
# user-systemd access as an interactive omp session.

[Unit]
Description=omp ClickClack bot pi
After=network-online.target clickclack.service omp-auth-broker.service
Wants=network-online.target omp-auth-broker.service

[Container]
ContainerName=omp-clickclack-pi
Image=localhost/omp-clickclack:3efe88e-omp18.3.5
Pull=never
UserNS=keep-id
Network=host
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_DATA_HOME=%h/.local/share
Environment=XDG_STATE_HOME=%h/.local/state
Environment=TMPDIR=/tmp
Environment=PI_CODING_AGENT_DIR=/bot/agent
Environment=CLICKCLACK_PI_AGENT_DIR=/bot/agent
Environment=CLICKCLACK_PI_STATE_PATH=/bot/state/bridge.sqlite
Environment=LCM_DB_DIR=/bot/agent/lcm
Environment=OMP_AUTH_BROKER_URL=http://127.0.0.1:8766
Volume=%h:%h:rw
Volume=/run/user/%U:/run/user/%U:rw
EnvironmentFile=%h/.config/omp-clickclack/pi.env
Secret=omp-clickclack-gh-token,type=env,target=GH_TOKEN
Environment=HOME=/bot/home
Environment=XDG_CONFIG_HOME=/bot/home/.config
Environment=XDG_DATA_HOME=/bot/home/.local/share
Environment=XDG_STATE_HOME=/bot/home/.local/state
Environment=XDG_CACHE_HOME=/bot/home/.cache
Environment=TMPDIR=/bot/tmp
Environment=PI_CODING_AGENT_DIR=/bot/agent
Environment=CLICKCLACK_PI_AGENT_DIR=/bot/agent
Environment=CLICKCLACK_PI_STATE_PATH=/bot/state/bridge.sqlite
Environment=LCM_DB_DIR=/bot/agent/lcm
Environment=OMP_AUTH_BROKER_URL=http://127.0.0.1:8766
Volume=%h/.local/share/omp-clickclack/pi:/bot:rw
Volume=%h/.omp/auth-broker.token:/bot/home/.omp/auth-broker.token:ro
Volume=%h/.gitconfig:/bot/home/.gitconfig:ro
Volume=%h/.ssh:/bot/home/.ssh:ro
# ssh multiplexing sockets (ControlPath ~/.ssh/cm) need a writable directory.
# notmpcopyup keeps the host's live sockets out of it.
Tmpfs=/bot/home/.ssh/cm:rw,mode=0700,U,notmpcopyup
# the bridge loads the standing voice profile from $HOME at startup. the global
# AGENTS.md and a skill refer to it by its host path, so mount it there too.
Volume=%h/.config/unslop/kas-voice-profile.md:/bot/home/.config/unslop/kas-voice-profile.md:ro
Volume=%h/.config/unslop/kas-voice-profile.md:%h/.config/unslop/kas-voice-profile.md:ro
# same global instructions and skills the pi bot loaded from ~/.pi/agent.
# notion-svg-diagrams is a symlink into ~/.agents/skills, so its target is
# mounted at the same path.
Volume=%h/.pi/agent/AGENTS.md:/bot/agent/AGENTS.md:ro
Volume=%h/.pi/agent/skills:/bot/agent/skills:ro
Volume=%h/.agents/skills/notion-svg-diagrams:%h/.agents/skills/notion-svg-diagrams:ro
Volume=%h/dev/pi-clickclack:%h/dev/pi-clickclack:rw
Volume=%h/dev/kassette:%h/dev/kassette:rw
Volume=%h/dev/orkastrator:%h/dev/orkastrator:rw
Volume=%h/dev/utmco:%h/dev/utmco:rw
Volume=%h/dev/clickclack:%h/dev/clickclack:rw
Volume=%h/dev/face:%h/dev/face:rw
Volume=%h/dev/kashh:%h/dev/kashh:rw
Volume=%h/dev/home:%h/dev/home:rw
Volume=%h/dev/matchfi-replit:%h/dev/matchfi-replit:rw
# pi-hindsight keeps retain cursors and receipts under <cwd>/.pi/hindsight.
# give the bot its own copy instead of sharing the workspace's.
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/pi-clickclack:%h/dev/pi-clickclack/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/kassette:%h/dev/kassette/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/orkastrator:%h/dev/orkastrator/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/utmco:%h/dev/utmco/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/clickclack:%h/dev/clickclack/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/face:%h/dev/face/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/kashh:%h/dev/kashh/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/home:%h/dev/home/.pi/hindsight:rw
Volume=%h/.local/share/omp-clickclack/pi/workspace-hindsight/matchfi:%h/dev/matchfi-replit/.pi/hindsight:rw
WorkingDir=%h/dev/pi-clickclack
Memory=4g
PidsLimit=1024
PodmanArgs=--memory-swap=4g --cpus=2 --device-write-bps=/dev/nvme0n1:60mb --device-read-bps=/dev/nvme0n1:200mb --device-write-iops=/dev/nvme0n1:2000
StopTimeout=30

[Service]
Slice=omp-clickclack.slice
ExecStartPre=%h/dev/omp-clickclack/deploy/preflight.sh
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target
